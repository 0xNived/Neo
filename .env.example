NEO_ENV=development
LOG_LEVEL=info
LLM_PROVIDER=ollama
# Leave LLM_MODEL blank to use the provider-specific model below.
LLM_MODEL=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MAX_TOOL_ROUNDS=8
NEO_OWNER_NAME=
NEO_OWNER_TIMEZONE=Asia/Calcutta
NEO_OWNER_API_KEY=
NEO_MEMORY_TTL_DAYS=90
NEO_DATABASE_PATH=.neo-data/neo.sqlite3
# Optional production persistence. Prefer this over SQLite for multi-process Neo.
DATABASE_URL=

# Only bot mode is accepted. Never put a Discord user token here.
DISCORD_MODE=bot
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=

# Telegram user account search: create these at my.telegram.org.
# The local session file is sensitive and is deliberately ignored by Git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=.neo-data/telegram

# Keep outbound actions approval-gated by default.
ALLOW_EXTERNAL_WRITES=false
