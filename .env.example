NEO_ENV=development
LOG_LEVEL=info
# ── Active model provider ───────────────────────────────────────────────────
# Choose: ollama | groq | cerebras | openrouter | openai_compatible | custom
LLM_PROVIDER=ollama
# This always wins over the provider-specific MODEL variable below.
LLM_MODEL=

# ── Generic / custom OpenAI-compatible endpoint ─────────────────────────────
# Use for any service exposing OpenAI's chat-completions protocol: OpenAI,
# LiteLLM, Codex Everywhere, vLLM, LM Studio, Together, etc.
# The URL may be either a base (https://provider.example/v1) or the complete
# endpoint (https://provider.example/v1/chat/completions).
LLM_BASE_URL=
LLM_API_KEY=
# Optional for providers that expose reasoning variants: low | medium | high |
# xhigh | max. Leave blank for providers that do not support it.
LLM_REASONING_EFFORT=

# ── Local Ollama ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Optional image understanding. A vision model is separate from normal chat.
# For a private RTX 3080 setup, use local Ollama after pulling a vision model:
#   ollama pull qwen2.5vl:7b
# Images stay local unless a different provider is explicitly configured.
VISION_PROVIDER=ollama
VISION_MODEL=
VISION_BASE_URL=http://localhost:11434
VISION_API_KEY=

# Optional browser for JavaScript-heavy public pages. Install the browser extra
# and Chromium first (see README), then enable it here. Neo uses a clean,
# isolated browser profile; it does not log in, submit forms, or buy items.
NEO_BROWSER_ENABLED=false
NEO_BROWSER_HEADLESS=true
NEO_BROWSER_TIMEOUT_SECONDS=20

# ── Hosted provider shortcuts ───────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MAX_TOOL_ROUNDS=8
NEO_OWNER_NAME=
NEO_OWNER_TIMEZONE=Asia/Calcutta
NEO_OWNER_API_KEY=
NEO_MEMORY_TTL_DAYS=90
NEO_DATABASE_PATH=.neo-data/neo.sqlite3
# Optional production persistence. Prefer this over SQLite for multi-process Neo.
DATABASE_URL=

# Only bot mode is accepted. Never put a Discord user token here.
DISCORD_MODE=bot
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=

# Telegram user account search: create these at my.telegram.org.
# The local session file is sensitive and is deliberately ignored by Git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=.neo-data/telegram

# Keep outbound actions approval-gated by default.
ALLOW_EXTERNAL_WRITES=false
